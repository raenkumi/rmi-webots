{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Webots build",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "WEBOTS_HOME": "/usr/local/webots"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}